{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code AI",
  "version": "2.0.0-alpha.1",
  "identifier": "ai.seul.codeai",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/prepare-ui.mjs",
    "beforeBuildCommand": "node scripts/prepare-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Code AI",
        "width": 1600,
        "height": 960,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://127.0.0.1:*; frame-src http://127.0.0.1:*; worker-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../shared/templates/": "templates/"
    },
    "category": "DeveloperTool",
    "shortDescription": "실시간 미리보기가 있는 AI 코딩 도구",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
