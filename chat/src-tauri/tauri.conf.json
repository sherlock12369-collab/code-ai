{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEUL Chat",
  "version": "1.0.0",
  "identifier": "ai.seul.chat",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/prepare-ui.mjs",
    "beforeBuildCommand": "node scripts/prepare-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SEUL Chat",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "귀여운 로봇 슬과 평소에 대화하는 앱",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
