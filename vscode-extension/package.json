{
  "name": "codeai",
  "displayName": "Code AI",
  "description": "AI로 코드를 짜는 도구 — 실시간 미리보기, 클릭 수정, 변경 기록, 원클릭 배포, 템플릿",
  "version": "1.0.0",
  "publisher": "codeai",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeai/code-ai"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "preview",
    "korean",
    "code ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeai",
          "title": "Code AI",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codeai": [
        {
          "type": "webview",
          "id": "codeai.chatView",
          "name": "채팅"
        }
      ]
    },
    "commands": [
      {
        "command": "codeai.openPreview",
        "title": "미리보기 열기",
        "category": "Code AI",
        "icon": "$(open-preview)"
      },
      {
        "command": "codeai.deploy",
        "title": "배포",
        "category": "Code AI",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codeai.startFromTemplate",
        "title": "템플릿으로 시작",
        "category": "Code AI",
        "icon": "$(file-code)"
      },
      {
        "command": "codeai.showHistory",
        "title": "변경 기록 보기 / 되돌리기",
        "category": "Code AI",
        "icon": "$(history)"
      },
      {
        "command": "codeai.newChat",
        "title": "새 대화",
        "category": "Code AI",
        "icon": "$(add)"
      },
      {
        "command": "codeai.checkServer",
        "title": "서버 연결 확인",
        "category": "Code AI"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeai.newChat",
          "when": "view == codeai.chatView",
          "group": "navigation@1"
        },
        {
          "command": "codeai.openPreview",
          "when": "view == codeai.chatView",
          "group": "navigation@2"
        },
        {
          "command": "codeai.showHistory",
          "when": "view == codeai.chatView",
          "group": "navigation@3"
        },
        {
          "command": "codeai.deploy",
          "when": "view == codeai.chatView",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "codeai.openPreview",
          "when": "resourceExtname =~ /^[.](html?|md|markdown|png|jpe?g|gif|svg|webp|pdf)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "codeai.openPreview",
          "when": "resourceExtname =~ /^[.](html?|md|markdown|png|jpe?g|gif|svg|webp|pdf)$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Code AI",
      "properties": {
        "codeai.serverUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "Code AI 서버 주소"
        },
        "codeai.maxContextFiles": {
          "type": "number",
          "default": 20,
          "description": "채팅 요청에 함께 보낼 작업 공간 파일의 최대 개수"
        },
        "codeai.autoOpenPreview": {
          "type": "boolean",
          "default": true,
          "description": "AI가 HTML 파일을 만들면 미리보기를 자동으로 엽니다"
        },
        "codeai.previewOnType": {
          "type": "boolean",
          "default": true,
          "description": "저장하지 않아도 입력할 때마다 미리보기를 새로고침합니다"
        }
      }
    }
  },
  "scripts": {
    "copy-templates": "node ./scripts/copy-templates.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run copy-templates && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
